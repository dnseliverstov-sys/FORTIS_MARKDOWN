{
  "name": "fortis-markdown-editor",
  "productName": "FORTIS Markdown Editor",
  "version": "1.0.0",
  "description": "Настольный markdown-редактор FORTIS: работа с папкой, вкладки, WYSIWYG и разметка, экспорт и импорт",
  "homepage": "https://fortis.local/markdown-editor",
  "author": "Дмитрий Селиверстов",
  "main": "app/main.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dev:renderer": "vite --config vite.config.mts",
    "build:renderer": "vite build --config vite.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:launcher": "node --test scripts/start.test.js",
    "test:e2e": "npm run build:renderer && playwright test",
    "test:smoke": "npm run build:renderer && playwright test --grep @smoke",
    "icon": "python3 scripts/make-icon.py",
    "dist": "npm run build:renderer && electron-builder",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:linux": "npm run build:renderer && node scripts/set-project.js --check && electron-builder --linux",
    "project": "node scripts/set-project.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/markdown-it": "13.0.9",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/turndown": "5.0.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "ru.fortis.markdown-editor",
    "productName": "FORTIS Markdown Editor",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "build/icon.png",
      "!**/.DS_Store"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "dmg": {
      "title": "FORTIS Markdown Editor"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "shortcutName": "FORTIS Markdown Editor"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "Настольный markdown-редактор FORTIS",
      "syncDesktopName": true,
      "maintainer": "FORTIS Markdown Editor <fortis@localhost>",
      "vendor": "FORTIS"
    },
    "afterPack": "./scripts/adhoc-sign.js",
    "deb": {
      "priority": "optional"
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    }
  },
  "desktopName": "fortis-markdown-editor.desktop",
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@diplodoc/latex-extension": "2.0.2",
    "@diplodoc/mermaid-extension": "2.0.0",
    "@diplodoc/transform": "4.77.15",
    "@gravity-ui/components": "4.24.0",
    "@gravity-ui/icons": "2.22.0",
    "@gravity-ui/markdown-editor": "15.46.0",
    "@gravity-ui/markdown-editor-latex-extension": "0.1.1",
    "@gravity-ui/uikit": "7.48.3",
    "dompurify": "3.4.14",
    "highlight.js": "11.12.0",
    "jszip": "3.10.1",
    "katex": "0.16.47",
    "lowlight": "3.3.0",
    "markdown-it": "13.0.2",
    "mermaid": "11.17.2",
    "path-browserify": "1.0.1",
    "process": "0.11.10",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "url": "0.11.4"
  }
}
