{
  "name": "fortis-markdown-editor",
  "productName": "FORTIS Markdown Editor",
  "version": "1.0.0",
  "description": "Настольный markdown-редактор FORTIS: работа с папкой, вкладки, WYSIWYG и разметка, экспорт и импорт",
  "homepage": "https://fortis.local/markdown-editor",
  "author": "Дмитрий Селиверстов",
  "main": "app/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "icon": "python3 scripts/make-icon.py",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "node scripts/set-project.js --check && electron-builder --linux",
    "project": "node scripts/set-project.js"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.fortis.markdown-editor",
    "productName": "FORTIS Markdown Editor",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "build/icon.png",
      "!**/.DS_Store"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "dmg": {
      "title": "FORTIS Markdown Editor"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "shortcutName": "FORTIS Markdown Editor"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "Настольный markdown-редактор FORTIS",
      "syncDesktopName": true,
      "maintainer": "FORTIS Markdown Editor <fortis@localhost>",
      "vendor": "FORTIS"
    },
    "afterPack": "./scripts/adhoc-sign.js",
    "deb": {
      "priority": "optional"
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    }
  },
  "desktopName": "fortis-markdown-editor.desktop"
}
